{
  "name": "mcplens",
  "version": "0.1.0",
  "description": "Inspect, lint, trace, and regression-test Model Context Protocol (MCP) servers from the command line.",
  "type": "module",
  "bin": {
    "mcplens": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/fixtures/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsshreyasbhardwaj-design/mcplens.git"
  },
  "homepage": "https://github.com/itsshreyasbhardwaj-design/mcplens#readme",
  "bugs": {
    "url": "https://github.com/itsshreyasbhardwaj-design/mcplens/issues"
  },
  "author": "Shreyas Bhardwaj",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "fixture:server": "tsx src/fixtures/example-server.ts",
    "fixture:http-server": "tsx src/fixtures/example-http-server.ts",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "debugger",
    "inspector",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
